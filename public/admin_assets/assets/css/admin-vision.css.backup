@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');

:root {
    --vision-bg-body: #0a0e1a;
    --vision-bg-sidebar: rgba(15, 20, 32, 0.95);
    --vision-bg-card: rgba(20, 25, 38, 0.7);
    --vision-bg-input: rgba(15, 20, 32, 0.8);

    --vision-primary: #4b0082;
    --vision-secondary: #d500f9;
    --vision-accent: #7c3aed;

    --vision-text-main: #e2e8f0;
    --vision-text-muted: #94a3b8;
    --vision-text-dark: #cbd5e1;

    --vision-border: rgba(148, 163, 184, 0.08);
    --vision-border-light: rgba(148, 163, 184, 0.12);
    --vision-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    --vision-glass-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);

    --sidebar-width: 280px;
}

[data-theme="light"] {
    --vision-bg-body: #f8fafc;
    --vision-bg-sidebar: rgba(255, 255, 255, 0.98);
    --vision-bg-card: rgba(255, 255, 255, 0.95);
    --vision-bg-input: #ffffff;

    --vision-primary: #4b0082;
    --vision-secondary: #d500f9;

    --vision-text-main: #1e293b;
    --vision-text-muted: #64748b;
    --vision-text-dark: #334155;

    --vision-border: rgba(148, 163, 184, 0.2);
    --vision-border-light: rgba(148, 163, 184, 0.3);
    --vision-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    --vision-glass-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
}

body {
    font-family: 'Inter', sans-serif;
    background-color: var(--vision-bg-body);
    color: var(--vision-text-main);
    transition: background 0.3s ease, color 0.3s ease;
    overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
    font-family: 'Outfit', sans-serif;
}

#layout-wrapper {
    background: transparent;
}

.main-content {
    margin-left: var(--sidebar-width);
    padding: 20px;
    transition: margin-left 0.3s ease;
}

.page-content {
    padding-top: 100px;
}

/* ========== COMPACT SIDEBAR ========== */
.app-menu.navbar-menu {
    position: fixed;
    top: 20px;
    bottom: 20px;
    left: 20px;
    width: var(--sidebar-width);
    background: var(--vision-bg-sidebar);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: 20px;
    border: 1px solid var(--vision-border-light);
    box-shadow: var(--vision-glass-shadow);
    z-index: 1002;
    padding: 16px 0;
    overflow-y: auto;
}

.navbar-brand-box {
    padding: 0 16px 14px;
    text-align: center;
    border-bottom: 1px solid var(--vision-border);
    margin-bottom: 10px;
}

.logo span {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 18px;
    color: var(--vision-text-main);
    text-transform: uppercase;
    letter-spacing: 1.2px;
}

.navbar-nav .nav-link {
    color: var(--vision-text-muted);
    font-weight: 500;
    font-size: 14px;
    padding: 10px 14px;
    margin: 2px 10px;
    border-radius: 10px;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    position: relative;
}

.navbar-nav .nav-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 0;
    background: var(--vision-primary);
    border-radius: 0 4px 4px 0;
    transition: height 0.3s ease;
}

.navbar-nav .nav-link i {
    font-size: 17px;
    margin-right: 10px;
    color: var(--vision-text-dark);
    background: rgba(148, 163, 184, 0.08);
    padding: 7px;
    border-radius: 8px;
    transition: all 0.3s ease;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.navbar-nav .nav-link:hover,
.navbar-nav .nav-link.active {
    background: rgba(148, 163, 184, 0.08);
    color: var(--vision-text-main);
}

.navbar-nav .nav-link:hover::before,
.navbar-nav .nav-link.active::before {
    height: 60%;
}

.navbar-nav .nav-link:hover i,
.navbar-nav .nav-link.active i {
    background: var(--vision-primary);
    color: white;
}

.menu-title {
    color: var(--vision-text-dark);
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 700;
    padding: 14px 18px 6px;
    opacity: 0.7;
    letter-spacing: 1px;
}

/* Topbar */
#page-topbar {
    position: fixed;
    top: 20px;
    left: calc(var(--sidebar-width) + 40px);
    right: 20px;
    background: var(--vision-bg-sidebar);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-radius: 16px;
    border: 1px solid var(--vision-border-light);
    padding: 16px 28px;
    z-index: 1001;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-shadow: var(--vision-shadow);
}

.topbar-left h4 {
    margin: 0;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
    color: var(--vision-text-main);
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* Cards */
.card {
    background: var(--vision-bg-card);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--vision-border);
    border-radius: 16px;
    box-shadow: var(--vision-shadow);
    margin-bottom: 24px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--vision-primary), transparent);
    transition: left 0.5s;
}

.card:hover {
    transform: translateY(-2px);
    border-color: var(--vision-border-light);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
}

.card:hover::before {
    left: 100%;
}

.card-header {
    background: transparent;
    border-bottom: 1px solid var(--vision-border);
    padding: 20px 24px;
}

.card-title {
    color: var(--vision-text-main);
    font-weight: 700;
    margin: 0;
    font-family: 'Outfit', sans-serif;
}

.card-body {
    padding: 24px;
}

/* Stats Widget */
.stat-widget-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: white;
    background: linear-gradient(135deg, #4b0082 0%, #6b21a8 100%);
    box-shadow: 0 4px 12px rgba(75, 0, 130, 0.25);
    transition: all 0.3s ease;
}

.card:hover .stat-widget-icon {
    transform: scale(1.05);
    box-shadow: 0 6px 16px rgba(75, 0, 130, 0.35);
    animation: iconPulse 0.6s ease-in-out;
}

.counter-value {
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 28px;
    color: var(--vision-text-main);
}

/* Buttons */
.btn-vision-primary {
    background: linear-gradient(135deg, #4b0082 0%, #6b21a8 100%);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 24px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(75, 0, 130, 0.2);
}

.btn-vision-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(75, 0, 130, 0.3);
    color: white;
}

.btn {
    position: relative;
    overflow: hidden;
}

.btn::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}

.btn:active::after {
    width: 300px;
    height: 300px;
}

/* Theme Toggle */
.theme-toggle-btn,
.lang-switcher-btn {
    background: rgba(148, 163, 184, 0.05);
    border: 1px solid var(--vision-border);
    color: var(--vision-text-dark);
    font-size: 18px;
    cursor: pointer;
    padding: 10px 12px;
    border-radius: 10px;
    transition: all 0.3s ease;
}

.theme-toggle-btn:hover,
.lang-switcher-btn:hover {
    background: rgba(148, 163, 184, 0.1);
    border-color: var(--vision-border-light);
    color: var(--vision-text-main);
}

.dropdown-menu-vision {
    background: var(--vision-bg-card);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--vision-border-light);
    border-radius: 12px;
    box-shadow: var(--vision-glass-shadow);
    padding: 8px;
}

.dropdown-item-vision {
    color: var(--vision-text-main);
    padding: 10px 16px;
    border-radius: 8px;
    transition: all 0.2s ease;
    margin: 2px 0;
}

.dropdown-item-vision:hover {
    background: rgba(148, 163, 184, 0.1);
    color: var(--vision-text-main);
}

/* Tables */
.table {
    color: var(--vision-text-main);
}

.table thead th {
    color: var(--vision-text-muted);
    border-bottom: 1px solid var(--vision-border);
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 700;
    opacity: 0.8;
    background: rgba(148, 163, 184, 0.03);
}

.table td {
    border-bottom: 1px solid var(--vision-border);
    vertical-align: middle;
}

.table tbody tr {
    transition: background 0.2s ease;
}

.table tbody tr:hover {
    background: rgba(148, 163, 184, 0.05);
}

/* Forms */
.form-control {
    background: var(--vision-bg-input);
    border: 1px solid var(--vision-border);
    color: var(--vision-text-main);
    border-radius: 12px;
    padding: 12px 16px;
    transition: all 0.3s ease;
}

.form-control:focus {
    background: var(--vision-bg-input);
    border-color: var(--vision-primary);
    color: var(--vision-text-main);
    box-shadow: 0 0 0 3px rgba(75, 0, 130, 0.1);
}

/* Scrollbar */
::-webkit-scrollbar {
    width: 6px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(75, 0, 130, 0.3);
    border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
    background: var(--vision-primary);
}

.footer {
    left: calc(var(--sidebar-width) + 40px);
    background: transparent;
    color: var(--vision-text-muted);
}

/* ========== UI/UX ENHANCEMENTS ========== */

/* Breadcrumb */
.breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 0 20px 0;
    font-size: 14px;
    flex-wrap: wrap;
}

.breadcrumb-item {
    color: var(--vision-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
    gap: 8px;
}

.breadcrumb-item:hover {
    color: var(--vision-primary);
}

.breadcrumb-item.active {
    color: var(--vision-text-main);
    font-weight: 600;
    pointer-events: none;
}

.breadcrumb-separator {
    color: var(--vision-border-light);
    user-select: none;
    font-size: 12px;
}

/* Trend Indicators */
.stat-trend {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 14px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 6px;
    margin-left: 12px;
}

.stat-trend.positive {
    color: #10b981;
    background: rgba(16, 185, 129, 0.1);
}

.stat-trend.negative {
    color: #ef4444;
    background: rgba(239, 68, 68, 0.1);
}

.stat-trend i {
    font-size: 16px;
}

.stat-period {
    font-size: 12px;
    color: var(--vision-text-muted);
    margin-top: 4px;
    display: block;
}

/* Animations */
@keyframes iconPulse {

    0%,
    100% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.1);
    }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.page-content {
    animation: fadeInUp 0.4s ease-out;
}

.card {
    animation: fadeInUp 0.5s ease-out backwards;
}

.row>.col-xl-3:nth-child(1) .card {
    animation-delay: 0.05s;
}

.row>.col-xl-3:nth-child(2) .card {
    animation-delay: 0.1s;
}

.row>.col-xl-3:nth-child(3) .card {
    animation-delay: 0.15s;
}

.row>.col-xl-3:nth-child(4) .card {
    animation-delay: 0.2s;
}

.row>.col-xl-3:nth-child(5) .card {
    animation-delay: 0.25s;
}

.row>.col-xl-3:nth-child(6) .card {
    animation-delay: 0.3s;
}

.row>.col-xl-3:nth-child(7) .card {
    animation-delay: 0.35s;
}

.row>.col-xl-3:nth-child(8) .card {
    animation-delay: 0.4s;
}

a {
    transition: color 0.2s ease;
}

.text-decoration-underline {
    text-underline-offset: 4px;
    transition: text-underline-offset 0.2s ease;
}

.text-decoration-underline:hover {
    text-underline-offset: 6px;
}